## ─────────────────────────────────────────────
##  Xenohuru API — Environment Variables Template
##  Copy this file to .env and fill in real values
##  Never commit .env to version control
## ─────────────────────────────────────────────

# ── Database (PostgreSQL) ────────────────────
DB_NAME=xenohuru
DB_USER=xenohuru
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=require


SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.100.1

# ── Cloudinary (Media Storage) ───────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── JWT Tokens ───────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# ── CORS / Frontend ──────────────────────────
FRONTEND_URL=http://localhost:3000

# Extra CORS origins beyond FRONTEND_URL and localhost (comma-separated, optional)
# Example: CORS_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
CORS_ALLOWED_ORIGINS=

# ── Email (Gmail SMTP) ───────────────────────
# To get Gmail App Password: myaccount.google.com > Security > 2FA > App Passwords
# For production, use a transactional provider (SendGrid, Mailgun, AWS SES)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=Xenohuru API <noreply@xenohuru.com>
CONTACT_EMAIL=your-personal-email@gmail.com

# For development (emails to console instead of sending):
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend


